# Zintellix Semantic Layer — Environment Configuration
# Copy this file to .env and fill in your values.

# === LLM Provider (pick one) ===
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# === Agent Config ===
# ZX_AGENT_PROVIDER=auto          # auto | gemini | openai | anthropic | off
# ZX_AGENT_MODEL=gemini-2.5-flash # Override the default model

# === Optional ===
# OPENAI_MODEL=gpt-4o-mini        # OpenAI model override
