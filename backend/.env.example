# Copy to .env and fill in. The agent uses OpenAI when OPENAI_API_KEY is set;
# otherwise it falls back to the deterministic reasoner (the demo still runs).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: force a provider (auto | openai | anthropic | off)
ZX_AGENT_PROVIDER=auto
# Optional: Anthropic instead of OpenAI
# ANTHROPIC_API_KEY=
